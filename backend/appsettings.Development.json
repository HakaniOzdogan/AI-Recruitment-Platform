{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=ik_otomasyon;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "ik-otomasyon-dev",
    "Audience": "ik-otomasyon-dev",
    "Secret": "REQUIRED_FROM_ENV",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "CvStorage": {
    "RootPath": "storage",
    "MaxFileSizeBytes": 10485760
  },
  "LLM": {
    "Enabled": false,
    "Provider": "openai",
    "ApiKey": "",
    "BaseUrl": "",
    "Model": "gpt-4o-mini",
    "TimeoutSeconds": 20
  },
  "Scoring": {
    "Mode": "deterministic",
    "LlmScoringEnabled": false
  },
  "AdaptiveInterview": {
    "Enabled": false,
    "LastMessageWindow": 8,
    "PlanHorizonMin": 2,
    "PlanHorizonMax": 3
  },
  "RateLimit": {
    "Enabled": false,
    "GlobalPerMinute": 120,
    "StrictPerMinute": 30
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:3000,http://localhost:5173"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Audit": {
    "LogUnauthorized": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
